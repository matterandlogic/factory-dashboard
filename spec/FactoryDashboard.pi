from ./builds import BUILD_EXECUTION, BUILD_OPEN_QUESTIONS
from ./scope import
    ADAPTATION_GUIDANCE,
    CAPABILITIES,
    DROP_IN_CONTRACT,
    ESTIMATE_POLICY,
    ESTIMATION_QUESTION,
    INITIAL_SUCCESS_CRITERIA,
    INTEGRATION_QUESTION,
    INTENDED_USERS,
    LIMITS_QUESTION,
    PRESENTATION,
    PURPOSE,
    REFRESH_QUESTION,
    SCOPE
from ./telemetry import
    DATA_COLLECTION,
    DATA_RELIABILITY_ACCEPTANCE_CRITERIA,
    HARNESS_QUESTION,
    RELIABILITY_OPEN_QUESTIONS,
    REPORTING_OPEN_QUESTIONS,
    SHARED_AGENT_REPORTING,
    SOURCE_QUESTION,
    SOURCE_RECONCILIATION,
    STALE_WORK_SWEEP,
    USAGE_OPEN_QUESTIONS,
    USAGE_REPORTING

export anchor FactoryDashboard:
    purpose: {PURPOSE}

    adaptationGuidance: {ADAPTATION_GUIDANCE}

    dropInContract: {DROP_IN_CONTRACT}

    intendedUsers: {INTENDED_USERS}

    capabilities: {CAPABILITIES}

    estimatePolicy: {ESTIMATE_POLICY}

    scope: {SCOPE}

    dataCollection: {DATA_COLLECTION}

    sharedAgentReporting: {SHARED_AGENT_REPORTING}

    sourceReconciliation: {SOURCE_RECONCILIATION}

    dataReliabilityAcceptanceCriteria: {DATA_RELIABILITY_ACCEPTANCE_CRITERIA}

    staleWorkSweep: {STALE_WORK_SWEEP}

    buildExecution: {BUILD_EXECUTION}

    usageReporting: {USAGE_REPORTING}

    presentation: {PRESENTATION}

    initialSuccessCriteria: {INITIAL_SUCCESS_CRITERIA}

    openQuestions:
        ++ {HARNESS_QUESTION}
        ++ {SOURCE_QUESTION}
        ++ {LIMITS_QUESTION}
        ++ {ESTIMATION_QUESTION}
        ++ {REPORTING_OPEN_QUESTIONS}
        ++ {RELIABILITY_OPEN_QUESTIONS}
        ++ {REFRESH_QUESTION}
        ++ {INTEGRATION_QUESTION}
        ++ {BUILD_OPEN_QUESTIONS}
        ++ {USAGE_OPEN_QUESTIONS}

