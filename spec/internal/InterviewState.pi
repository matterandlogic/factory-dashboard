export INTERVIEW_STATE:
    questionBudget: 5
    questionsAnswered: 5
    specificationGenerated: true
    status: Initial round complete; implementation skill requested and added.
    currentFocus: Use the implementation skill in the consuming application.
    outstandingInterviewQuestions: []

export DEEP_DIVE_STATE:
    target: Reporting lifecycle and comprehensive usage.
    questionBudget: 5
    questionsAnswered: 5
    refinementApplied: true
    awaitingAcceptance: false
    status: Accepted; interview round complete.
    currentFocus: No active interview; unresolved questions remain deferred.
    decisions:
        - Partial telemetry is accepted with unknown metrics.
        - Agents must supply available metrics automatically in a shared format.
        - Agent reports take precedence over conflicting harness reports.
        - Reasonable configurable freshness defaults are delegated to the author.
        - Each retry has its own attempt identity and reports carry sequence numbers.
        - Three missed heartbeats mark live reporting stale; completed results stay valid.
        - A harness hook or background reporter maintains independent heartbeats.
        - Comprehensive usage includes breakdowns, trends, shared quotas, and available costs.
    remainingUncertainty:
        Concrete source capabilities, serialization, transport, report
        validation and restart recovery, and estimation methods remain open as
        recorded in openQuestions.
